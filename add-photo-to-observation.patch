+        let obsPhotoData = null; // compressed base64 data URL, or null if no photo attached
+
+        function handleObsPhotoSelected(event) {
+            const file = event.target.files[0];
+            const statusDiv = document.getElementById('obsPhotoStatus');
+            if (!file) return;
+
+            if (!file.type.startsWith('image/')) {
+                statusDiv.textContent = '⚠️ Please choose an image file';
+                event.target.value = '';
+                return;
+            }
+
+            statusDiv.textContent = 'Compressing photo...';
+
+            const reader = new FileReader();
+            reader.onload = function(e) {
+                const img = new Image();
+                img.onload = function() {
+                    // Resize so the longest side is at most 1280px, then re-encode
+                    // as JPEG at 70% quality — a typical phone photo (4-10MB) comes
+                    // down to roughly 150-400KB, well within what we can store and
+                    // email without trouble.
+                    const maxDim = 1280;
+                    let { width, height } = img;
+                    if (width > height && width > maxDim) {
+                        height = Math.round(height * (maxDim / width));
+                        width = maxDim;
+                    } else if (height > maxDim) {
+                        width = Math.round(width * (maxDim / height));
+                        height = maxDim;
+                    }
+
+                    const canvas = document.createElement('canvas');
+                    canvas.width = width;
+                    canvas.height = height;
+                    canvas.getContext('2d').drawImage(img, 0, 0, width, height);
+
+                    obsPhotoData = canvas.toDataURL('image/jpeg', 0.7);
+
+                    document.getElementById('obsPhotoPreview').src = obsPhotoData;
+                    document.getElementById('obsPhotoPreviewWrap').style.display = 'block';
+                    const approxKb = Math.round((obsPhotoData.length * 0.75) / 1024);
+                    statusDiv.textContent = `Photo attached (~${approxKb}KB)`;
+                };
+                img.onerror = function() {
+                    statusDiv.textContent = '⚠️ Could not read that image — try a different photo';
+                };
+                img.src = e.target.result;
+            };
+            reader.readAsDataURL(file);
+        }
+
+        function clearObsPhoto() {
+            obsPhotoData = null;
+            document.getElementById('obsPhotoInput').value = '';
+            document.getElementById('obsPhotoPreviewWrap').style.display = 'none';
+            document.getElementById('obsPhotoStatus').textContent = '';
+        }
+
