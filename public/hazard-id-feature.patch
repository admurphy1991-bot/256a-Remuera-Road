+        // Hazard ID Functions
+        let hazards = [];
+
+        const SEVERITY_LEVELS = {
+            near_miss: { label: 'Near Miss',      emoji: '😌', cls: 'sv-near_miss' },
+            minor:     { label: 'Minor Injury',   emoji: '🤕', cls: 'sv-minor' },
+            injury:    { label: 'Injury',         emoji: '🚑', cls: 'sv-injury' },
+            serious:   { label: 'Serious Injury', emoji: '🚨', cls: 'sv-serious' },
+            fatality:  { label: 'Fatality',       emoji: '💀', cls: 'sv-fatality' }
+        };
+
+        function severityInfo(key) {
+            return SEVERITY_LEVELS[key] || { label: key || 'Unknown', emoji: '❓', cls: '' };
+        }
+
+        function selectSeverity(value, btnEl) {
+            document.getElementById('hazardSeverity').value = value;
+            document.querySelectorAll('#severityPicker .severity-btn').forEach(b => b.classList.remove('selected'));
+            btnEl.classList.add('selected');
+        }
+
+        function clearSeverityPicker() {
+            document.getElementById('hazardSeverity').value = '';
+            document.querySelectorAll('.severity-btn.selected').forEach(b => b.classList.remove('selected'));
+        }
+
+        async function fetchHazards() {
+            try {
+                const response = await fetch('/api/hazards');
+                if (!response.ok) throw new Error('Failed to fetch');
+                hazards = await response.json();
+                updateHazardDisplay();
+                renderHazardBoard();
+            } catch (error) {
+                console.error('Error fetching hazards:', error);
+                showAlert('Failed to load hazard register', 'error');
+            }
+        }
+
+        function renderHazardBoard() {
+            const boardDiv = document.getElementById('hazardBoardList');
+            if (!boardDiv) return;
+
+            const openHazards = hazards.filter(h => h.status !== 'Closed');
+
+            if (openHazards.length === 0) {
+                boardDiv.innerHTML = '<div class="empty-state">No open hazards currently logged for this site.</div>';
+                return;
+            }
+
+            boardDiv.innerHTML = openHazards.map(h => {
+                const sev = severityInfo(h.severity);
+                return `
+                    <div class="hazard-card">
+                        <div class="hazard-desc">${h.description}</div>
+                        <div class="hazard-details">
+                            <span class="severity-badge ${sev.cls}">${sev.emoji} ${sev.label}</span><br>
+                            📍 ${h.location || 'Not specified'}
+                            ${h.immediateAction ? `<br>Current control: ${h.immediateAction}` : ''}
+                        </div>
+                    </div>
+                `;
+            }).join('');
+        }
+
+        async function reportHazard(hazardData) {
+            try {
+                const response = await fetch('/api/hazards', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify(hazardData)
+                });
+                if (!response.ok) throw new Error('Failed to report');
+                await fetchHazards();
+                return true;
+            } catch (error) {
+                console.error('Error reporting hazard:', error);
+                showAlert('Failed to report hazard', 'error');
+                return false;
+            }
+        }
+
+        async function closeOutHazard(id) {
+            const closedAction = prompt('Corrective action / how was this closed out?');
+            if (closedAction === null) return;
+            const closedBy = prompt('Closed out by (your name):');
+            if (closedBy === null) return;
+
+            try {
+                const response = await fetch(`/api/hazards/${id}/close`, {
+                    method: 'PUT',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({ closedAction, closedBy })
+                });
+                if (!response.ok) throw new Error('Failed to close out');
+                await fetchHazards();
